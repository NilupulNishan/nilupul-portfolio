GITHUB_TOKEN=your_github_token_here

# Testimonials. Only VITE_-prefixed vars reach the browser - that is why the Google
# client ID appears twice. Never add a VITE_ prefix to the Upstash token, the Resend
# key, or the delete secret; doing so bundles them into the public JS.
VITE_GOOGLE_CLIENT_ID=       # public by design, reaches the browser
GOOGLE_CLIENT_ID=            # server-side aud check (same value)
UPSTASH_REDIS_REST_URL=      # or KV_REST_API_URL via the Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=    # or KV_REST_API_TOKEN
RESEND_API_KEY=
TESTIMONIAL_NOTIFY_EMAIL=    # where the new-testimonial notification is sent
TESTIMONIAL_FROM_EMAIL=      # optional; defaults to onboarding@resend.dev
TESTIMONIAL_DELETE_SECRET=   # long random string, signs the one-click delete link
SITE_URL=                    # optional; origin used to build the delete link
